#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const git = require('./runtime/git-snapshot.cjs');
const quint = require('./runtime/quint-model.cjs');
const tlc = require('./runtime/tlc.cjs');

const SIDES = ['old', 'new'];
const usage = 'Usage: git quint-diff --review FILE [--json] OLD NEW\n' +
  '       git quint-diff --discover --entrypoint PATH --module MODULE --step ACTION [--route MODULE::ACTION]... [--json] REV';
const isObject = x => x !== null && typeof x === 'object' && !Array.isArray(x);
const text = x => typeof x === 'string' && x.trim() !== '';
const actionName = x => text(x) && x.split('::').every(s => quint.IDENT.test(s));
const positive = x => Number.isSafeInteger(x) && x > 0;
const keys = (x, allowed) => isObject(x) && Object.keys(x).every(k => allowed.includes(k));
const position = x => positive(x.line) && positive(x.column);
const sourcePosition = x => keys(x, ['path', 'line', 'column']) && position(x) && (x.path === undefined || text(x.path));
const via = x => x === undefined || (Array.isArray(x) && x.length > 0 && x.every(sourcePosition));
const routing = x => x === undefined || (Array.isArray(x) && x.every(s => actionName(s) && s.includes('::')) &&
  new Set(x).size === x.length);
const scalar = x => typeof x === 'boolean' || typeof x === 'string' || Number.isSafeInteger(x);
const historyKey = JSON.stringify;

function args(argv) {
  const revisions = [];
  const source = {};
  let review, discover = false, json = false, options = true;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (options && arg === '--') options = false;
    else if (options && arg === '--review' && !review && argv[i + 1]) review = argv[++i];
    else if (options && arg === '--discover' && !discover) discover = true;
    else if (options && arg === '--json' && !json) json = true;
    else if (options && arg === '--route') {
      if (!argv[i + 1] || argv[i + 1].startsWith('--')) throw new Error(`missing value for ${arg}`);
      (source.routing ??= []).push(argv[++i]);
    } else if (options && ['--entrypoint', '--module', '--step'].includes(arg)) {
      const key = arg.slice(2);
      if (Object.hasOwn(source, key)) throw new Error(`repeated option: ${arg}`);
      if (!argv[i + 1] || argv[i + 1].startsWith('--')) throw new Error(`missing value for ${arg}`);
      source[key] = argv[++i];
    } else if (options && arg.startsWith('-')) throw new Error(`unknown or repeated option: ${arg}`);
    else revisions.push(arg);
  }
  if (discover) {
    if (review || revisions.length !== 1 || !text(source.entrypoint) ||
        !quint.IDENT.test(source.module ?? '') || !actionName(source.step)) {
      throw new Error('--discover needs an entrypoint, module, scheduler step and one committed revision (no review file)');
    }
    if (!routing(source.routing)) throw new Error('--route needs a distinct resolved MODULE::ACTION each time');
  } else if (!review || revisions.length !== 2 || Object.keys(source).length) {
    throw new Error('expected a review file and two committed revisions');
  }
  return { review, discover, source, revisions, json };
}

function reviewConfig(file) {
  const require = (test, message) => { if (!test) throw new Error(message); };
  const data = JSON.parse(fs.readFileSync(file, 'utf8'));
  require(keys(data, ['scenario', 'histories', ...SIDES]) && text(data.scenario), 'review needs a scenario name');
  const histories = data.histories;
  require(Array.isArray(histories) && histories.length > 0 && histories.every(h => Array.isArray(h) && h.length <= 2 && h.every(text)),
    'select a nonempty list of exact histories of length 0–2');
  require(new Set(histories.map(historyKey)).size === histories.length, 'duplicate history');
  const labels = new Set(histories.flat());
  for (const name of SIDES) {
    const side = data[name];
    require(keys(side, ['entrypoint', 'module', 'constants', 'init', 'step', 'routing', 'observe', 'bindings', 'hidden']) &&
      text(side.entrypoint) && text(side.observe) && text(side.module) && quint.IDENT.test(side.module) &&
      ['init', 'step'].every(k => actionName(side[k])),
    `${name}: specify entrypoint, module, init, step and observe`);
    require(routing(side.routing), `${name}: routing must list distinct resolved MODULE::ACTION names`);
    require(side.constants === undefined || (isObject(side.constants) &&
      Object.entries(side.constants).every(([k, v]) => quint.IDENT.test(k) && scalar(v))),
    `${name}: constants must map identifiers to scalar literals`);
    require(isObject(side.bindings) && [...labels].every(label => Object.hasOwn(side.bindings, label)),
      `${name}: explicitly bind each requested label (use null for absence)`);
    for (const [label, selector] of Object.entries(side.bindings)) {
      require(text(label) && (selector === null || (keys(selector, ['callee', 'path', 'line', 'column', 'via', 'when', 'args']) &&
        text(selector.callee) && via(selector.via) &&
        (selector.when === undefined || text(selector.when)) && (selector.path === undefined || text(selector.path)) &&
        (selector.args === undefined || (Array.isArray(selector.args) && selector.args.every(scalar))) &&
        (position(selector) || (selector.line === undefined && selector.column === undefined && selector.path === undefined)))),
      `${name}: invalid selector for ${label}`);
    }
    require(Array.isArray(side.hidden) && side.hidden.every(h => keys(h, ['path', 'line', 'column', 'via']) &&
      via(h.via) && sourcePosition({ path: h.path, line: h.line, column: h.column })),
      `${name}: hidden must list leaf positions`);
  }
  data.histories.sort((a, b) => a.length - b.length || tlc.compare(historyKey(a), historyKey(b)));
  return data;
}

function differences(report, nodes, results) {
  const order = (a, b) => typeof a === typeof b ? tlc.compare(a, b) : tlc.compare(typeof a, typeof b);
  return nodes.filter(n => n.selected).sort((a, b) => a.history.length - b.history.length ||
    tlc.compare(historyKey(a.history), historyKey(b.history))).map(({ id, history }) => {
    const values = results.map(r => r.byPrefix[id]);
    const rows = values.map((frontier, index) => {
      const outcomes = [...frontier.keys()].sort(order);
      if (outcomes.length) return { outcomes };
      let node = nodes[0];
      if (!results[index].reached.has(0)) return { outcomes, reason: 'no-initial-state' };
      for (const label of history) {
        node = node.children.get(label);
        if (!results[index].reached.has(node.id)) {
          return { outcomes, reason: report[SIDES[index]].bindings[label] === null ? 'absent' : 'disabled', label };
        }
      }
      quint.fail('evidence', 'reached requested history has no observation');
    });
    const deltas = values.flatMap((frontier, index) => [...frontier.keys()].sort(order)
      .filter(outcome => !values[1 - index].has(outcome)).map(outcome => ({
        change: index === 0 ? '-' : '+', outcome,
        witness: { revision: report[SIDES[index]].revision, scenario: report.scenario, history, outcome, ...frontier.get(outcome) },
      })));
    return { history, old: rows[0], new: rows[1], deltas };
  });
}

function review(config, revisions) {
  const nodes = tlc.prefixes(config.histories);
  const report = {
    version: 1, status: 'incomplete', scenario: config.scenario,
    scope: { histories: config.histories, nativeTransitionBound: null, hidden: 'explicit-only',
      observationPoint: 'end-of-exact-history', backendTimeoutMs: tlc.TIMEOUT, backend: 'Quint 0.33.1 / Apalache 0.62.4 / TLC' },
    histories: [], diagnostics: [],
    ...Object.fromEntries(SIDES.map((side, i) => [side, { ...config[side], requestedRevision: revisions[i], revision: null }])),
  };
  let side = null, phase = 'backend', scratch;
  try {
    // Pin both revisions before loading or exploring either one.
    for (const name of SIDES) {
      side = name;
      phase = 'snapshot';
      report[side].revision = git.resolve(report[side].requestedRevision);
    }
    side = null;
    phase = 'backend';
    const api = quint.quintApi();
    const jar = tlc.findJar();
    const prepared = [];
    for (const name of SIDES) {
      side = name;
      const options = config[side];
      const snap = git.snapshot(report[side].revision);
      phase = 'parse';
      const model = quint.parseModel(api, snap, options);
      phase = 'binding';
      const binding = quint.bind(model, options);
      Object.assign(report[side], { bindings: binding.bindings, hidden: binding.hidden, scheduler: binding.scheduler,
        blobs: blobIds(snap), observationType: model.type });
      phase = 'compile';
      prepared.push({ binding, type: model.type, module: model.module, ir: quint.compilation(api, model, binding) });
    }
    side = null;
    if (prepared[0].type !== prepared[1].type) quint.fail('observation', 'OLD and NEW observation types differ');
    phase = 'exploration';
    scratch = fs.mkdtempSync(path.join(os.tmpdir(), 'git-quint-diff-'));
    const results = prepared.map(({ binding, type, module, ir }, i) => {
      side = SIDES[i];
      const cwd = path.join(scratch, side);
      fs.mkdirSync(cwd);
      const outcome = tlc.explore(jar, cwd, module, ir, binding.leaves, nodes, type);
      report[side].closure = outcome.stats;
      return outcome;
    });
    side = null;
    phase = 'evidence';
    report.histories = differences(report, nodes, results);
    report.status = 'exhaustive';
  } catch (error) {
    report.diagnostics.push({ side, phase: error.phase ?? phase, message: error.message });
  } finally {
    if (scratch) fs.rmSync(scratch, { recursive: true, force: true });
  }
  return report;
}

function blobIds(snap) {
  return Object.fromEntries([...snap.blobs].sort(([a], [b]) => tlc.compare(a, b)));
}

function discover(config, requestedRevision) {
  const report = { version: 1, mode: 'discovery', status: 'incomplete', requestedRevision, revision: null,
    ...config, scheduler: null, blobs: {}, leaves: [], diagnostics: [] };
  let phase = 'snapshot';
  try {
    report.revision = git.resolve(requestedRevision);
    const snap = git.snapshot(report.revision);
    phase = 'backend';
    const api = quint.quintApi();
    phase = 'parse';
    const model = quint.parseModel(api, snap, config, { discovery: true });
    phase = 'binding';
    Object.assign(report, quint.discover(model, config), { blobs: blobIds(snap), status: 'complete' });
  } catch (error) {
    report.diagnostics.push({ phase: error.phase ?? phase, message: error.message });
  }
  return report;
}

const loc = ({ path, line, column }, entrypoint) => `${path ?? entrypoint}:${line ?? '?'}:${column ?? '?'}`;
const formatVia = (hops, entrypoint) => hops?.length ? ` via ${hops.map(hop =>
  `${loc(hop, entrypoint)}${hop.callee ? ` ${hop.callee} → ${loc(hop.declaration)}` : ''}`).join('; ')}` : '';

function discoveryTerminal(report) {
  const lines = [`Discovery: ${report.status}`, `Commit: ${report.revision ?? report.requestedRevision}`,
    `Entrypoint: ${report.entrypoint} (${report.module}, step ${report.step})`,
    'Scope: source positions only; no reachability or cross-revision mapping checked.'];
  if (report.routing?.length) lines.push(`Routing: ${report.routing.join(', ')}`);
  if (report.scheduler) {
    const { module, action } = report.scheduler;
    lines.push(`Scheduler: ${module}::${action} at ${loc(report.scheduler)}`);
    for (const { leaf, call, via } of report.leaves) {
      lines.push(`  Leaf ${loc(leaf)}${formatVia(via, report.entrypoint)}`, call ?
        `    Call ${loc(call.selector)} ${call.selector.callee} → ${loc(call.declaration)}` :
        '    No supported public selector');
    }
  }
  for (const { phase, message } of report.diagnostics) lines.push(`${phase}: ${message}`);
  return lines.join('\n');
}

function terminal(report) {
  const lines = [`Scenario: ${report.scenario}`, `Status: ${report.status}`,
    `Scope: exact histories ${report.scope.histories.map(h => `[${h.join(' → ')}]`).join(', ')}; explicit hidden steps only; no native-transition bound`,
    `Observation point: end of exact history (initial state for [])`,
    `Backend: ${report.scope.backend}; timeout: ${report.scope.backendTimeoutMs / 1000}s per Java process`];
  for (const side of SIDES) {
    const data = report[side];
    lines.push(`${side.toUpperCase()} ${data.revision ?? data.requestedRevision}: ${data.entrypoint} (${data.module}, init ${data.init}, step ${data.step})`,
      `  Observe: ${data.observe}${data.observationType ? ` (${data.observationType})` : ''}`);
    if (data.constants !== undefined) lines.push(`  Constants: ${JSON.stringify(data.constants)}`);
    if (data.routing?.length) lines.push(`  Routing: ${data.routing.join(', ')}`);
    if (data.scheduler) lines.push(`  Scheduler: ${data.scheduler.module}::${data.scheduler.action} at ${loc(data.scheduler)}`);
    else lines.push('  Requested selectors (not resolved):');
    for (const [label, site] of Object.entries(data.bindings)) {
      if (!site) { lines.push(`  ${label}: absent (explicit)`); continue; }
      const declaration = site.declaration ? ` → ${loc(site.declaration)}` : '';
      const filter = site.when ? ` when ${site.when} (pre-state)` : site.args !== undefined ? ` with args ${JSON.stringify(site.args)}` : '';
      lines.push(`  ${label}: ${loc(site, data.entrypoint)} ${site.callee}${declaration}${filter}${formatVia(site.via, data.entrypoint)}`);
    }
    for (const site of data.hidden) lines.push(`  Hidden: ${loc(site, data.entrypoint)}${formatVia(site.via, data.entrypoint)}`);
    if (data.closure) lines.push(`  Search: ${data.closure.generated} generated, ${data.closure.distinct} distinct, ${data.closure.queued} queued`);
  }
  for (const entry of report.diagnostics) lines.push(`${entry.side?.toUpperCase() ?? 'Comparison'} ${entry.phase}: ${entry.message}`);
  for (const row of report.histories) {
    lines.push(`\n[${row.history.join(' → ')}]`);
    for (const name of SIDES) {
      const { outcomes, reason, label } = row[name];
      lines.push(`  ${name.toUpperCase()}: ${outcomes.length ? JSON.stringify(outcomes) : `no matching execution (${reason}${label ? `: ${label}` : ''})`}`);
    }
    for (const { change, outcome, witness } of row.deltas) {
      lines.push(`${change} ${JSON.stringify(outcome)} (${witness.revision})`, `    init ${JSON.stringify(witness.initial)}`);
      for (const { state, site, label } of witness.steps) {
        lines.push(`    ${label ?? 'hidden'} ${loc(site)}${formatVia(site.via)} → ${JSON.stringify(state)}`);
      }
    }
  }
  return lines.join('\n');
}

if (process.argv.length === 3 && process.argv[2] === '--help') {
  console.log(usage);
} else {
  try {
    const options = args(process.argv.slice(2));
    const report = options.discover ? discover(options.source, options.revisions[0]) :
      review(reviewConfig(options.review), options.revisions);
    console.log(options.json ? JSON.stringify(report, null, 2) :
      options.discover ? discoveryTerminal(report) : terminal(report));
    process.exitCode = report.status === 'incomplete' ? 1 : 0;
  } catch (error) {
    console.error(`${error.message}\n${usage}`);
    process.exitCode = 2;
  }
}
